# Contoh konfigurasi env — SALIN nilai nyatanya ke .env.local / dashboard Vercel.
# Jangan pernah menaruh nilai asli di file ini.

# ── Cron / keep-alive ────────────────────────────────────────────────────────
# Kalau di-set, /api/keep-alive hanya menerima `Authorization: Bearer <nilai>`
# (Vercel Cron mengirimnya otomatis). Kosong = endpoint terbuka (perilaku lama).
CRON_SECRET=

# ── Fitur DAO (/dao) ─────────────────────────────────────────────────────────
# Link undangan Discord per DAO. HANYA dibaca server (tidak pernah dikirim ke
# klien sebelum user login + lulus kuis). Key = DAO_INVITE_<ID_UPPERCASE>,
# mengikuti `id` di src/server/daos.server.ts.
# Format wajib: https://discord.gg/xxxx ATAU https://discord.com/invite/xxxx
# Kosong / format salah = kartu DAO tampil "Segera hadir" (bukan error).
DAO_INVITE_WEB3MIN=https://discord.gg/xxxx
DAO_INVITE_DOMPET_AMAN=
DAO_INVITE_RISET_BARENG=
